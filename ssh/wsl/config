Host github.com
  User git
  Port 22
  Hostname github.com
  IdentityFile "~/.ssh/id_ed25519_for_github"
  TCPKeepAlive yes
  # Make sure connection from LAN device in shadowsocks is enabled
  # see https://github.com/shadowsocks/shadowsocks-windows/issues/2686#issuecomment-567060016
  Proxycommand ncat --proxy `grep -m 1 nameserver /etc/resolv.conf | awk '{print $2}'`:1080 --proxy-type socks5 %h %p

Host ssh.github.com
  User git
  Port 443
  Hostname ssh.github.com
  IdentityFile "~/.ssh/id_ed25519_for_github"
  TCPKeepAlive yes
  Proxycommand ncat --proxy `grep -m 1 nameserver /etc/resolv.conf | awk '{print $2}'`:1080 --proxy-type socks5 %h %p

# Uncomment the following lines if you want to use 443 port for GitHub SSH connections
# Host github.com
#   User git
